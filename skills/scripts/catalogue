#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The skill is installed as a copy outside the repository, so the project cannot
# be assumed to be two directories up. Resolve it in order of explicitness:
#   1. AIMI_HOME, for an agent pointing at a specific checkout
#   2. the repository layout, when running from skills/scripts/ inside the repo
#   3. project-path, written into the skill directory by install.py
if [ -n "${AIMI_HOME:-}" ] && [ -x "$AIMI_HOME/aimi" ]; then
  PROJECT="$AIMI_HOME"
elif [ -x "$SCRIPT_DIR/../../aimi" ]; then
  PROJECT="$(cd "$SCRIPT_DIR/../.." && pwd)"
elif [ -f "$SCRIPT_DIR/../project-path" ]; then
  PROJECT="$(cat "$SCRIPT_DIR/../project-path")"
else
  echo "catalogue: cannot locate the AIMI project. Set AIMI_HOME or re-run install.py." >&2
  exit 1
fi
if [ ! -x "$PROJECT/aimi" ]; then
  echo "catalogue: no aimi CLI at $PROJECT. Set AIMI_HOME or re-run install.py." >&2
  exit 1
fi
AIMI="$PROJECT/aimi"

# The operational AIMI database lives on Pal. On macOS, route database and
# endpoint reads through the installed forwarding shim unless AIMI_HOME was
# explicitly set for local development/testing. Local harness commands below
# remain local because their configuration is Mac-only.
PAL_AIMI=""
if [ -z "${AIMI_HOME:-}" ] && [ "$(uname -s)" = "Darwin" ] && [ -x "$HOME/bin/aimi" ]; then
  PAL_AIMI="$HOME/bin/aimi"
fi

command_name="${1:-summary}"
if [ "$#" -gt 0 ]; then shift; fi
case "$command_name" in
  # Current operational catalogue reads must use Pal on macOS. Keep local
  # harness/configuration commands out of this group.
  summary|free|latest-free|free-health|free-health-summary|latest|timeline|providers|provider-models|subscriptions|subscription|promotion-accounts|personal-email-accounts|model-info|maker-models|route|test|changes|changes-review|monitor-runs|monitor-status|doctor|recommend|deepseek-status|deepswe|benchmarks)
    if [ -n "$PAL_AIMI" ]; then
      exec "$PAL_AIMI" "$command_name" "$@"
    fi
    cd "$PROJECT"
    exec python3 "$AIMI" "$command_name" "$@"
    ;;
  monitor)
    exec zsh -lc 'source ~/.zshrc >/dev/null 2>&1; cd "$1"; exec python3 monitor_endpoints.py' -- "$PROJECT"
    ;;
  scan)
    cd "$PROJECT"
    exec python3 scan_local_harnesses.py "$@"
    ;;
  validate)
    cd "$PROJECT"
    exec python3 validate_catalogue.py "$@"
    ;;
  export)
    cd "$PROJECT"
    exec python3 export_sanitized.py "$@"
    ;;
  refresh)
    exec zsh -lc 'source ~/.zshrc >/dev/null 2>&1; cd "$1"; exec python3 refresh_catalog.py' -- "$PROJECT"
    ;;
  ingest-latest)
    cd "$PROJECT"
    exec python3 ingest_latest_evidence.py "$@"
    ;;
  ingest-frontier)
    cd "$PROJECT"
    exec python3 ingest_frontier_evidence.py "$@"
    ;;
  ingest-subscriptions)
    cd "$PROJECT"
    exec python3 ingest_subscriptions.py "$@"
    ;;
  record-warp-tests)
    cd "$PROJECT"
    exec python3 record_warp_tests.py "$@"
    ;;
  cron-runs)
    exec hermes cron runs f8ff78fe2fb2
    ;;
  db-path)
    printf '%s\n' "$PROJECT/aimi.db"
    ;;
  project-path)
    printf '%s\n' "$PROJECT"
    ;;
  *)
    cd "$PROJECT"
    exec python3 "$AIMI" "$command_name" "$@"
    ;;
esac
