def harness_fragment(c, a):
    """Generate the exact config fragment to point any harness at a provider/model route."""
    known = c.execute('SELECT display_name FROM harnesses WHERE harness_id=?', (a.harness,)).fetchone()
    if not known:
        raise SystemExit(f'Unknown harness id: {a.harness}. Use `aimi harnesses` to list known ids.')
    recipe = HARNESS_CONFIG.get(a.harness)
    if recipe is None:
        print(json.dumps({'harness': a.harness, 'display_name': known['display_name'], 'provider': a.provider, 'model': a.model,
                          'notes': [f'No built-in fragment generator for {a.harness}. Configure manually; config guidance lives in harness_provider_support.']}, indent=2))
        return
    frag = recipe['gen'](c, a.provider, a.model)
    out = {'harness': a.harness, 'display_name': known['display_name'], 'provider': a.provider, 'model': a.model,
           'config_path': frag.get('path'), 'config_format': recipe.get('format'),
           'apply_via': frag.get('apply'), 'config': frag.get('config'),
           'notes': frag.get('notes')}
    print(json.dumps({k: v for k, v in out.items() if v is not None}, indent=2, default=str))


