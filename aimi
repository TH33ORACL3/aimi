# Aside (browser agent) custom provider config. The daemon caches models.json at
# startup, so a newly added provider needs an app restart, and the combined
# `aside -m <provider>/<model>` form is how the CLI resolves custom providers.
ASIDE_DIR=HOME/'.aside'/'u'/'0'
ASIDE_MODELS_PATH=ASIDE_DIR/'models.json'
ASIDE_CREDENTIALS_PATH=ASIDE_DIR/'credentials.json'
ASIDE_COMPAT={'supportsStore':False,'supportsDeveloperRole':False,'supportsReasoningEffort':False,'maxTokensField':'max_tokens','supportsStrictMode':False,'supportsLongCacheRetention':False}
# Aside exposes the extended reasoning selector from this map. `ultrabrowse`
# is a separate proactive mode supplied by Aside, not a provider model key.
ASIDE_THINKING_LEVEL_MAP={level: level for level in ('off','minimal','low','medium','high','xhigh','max')}
ASIDE_DEFAULT_CONTEXT=128000
ASIDE_DEFAULT_MAX_TOKENS=16384

def aside_provider_fragment(c,pid,mid):
 row=c.execute("""SELECT pm.provider_id,pm.model_identifier,pm.display_name,pm.reasoning,
   pm.context_window_tokens,pm.max_output_tokens,pm.input_modalities_json,
   p.display_name provider_name,p.base_url,p.api_style,p.auth_env_var
   FROM provider_models_v2 pm JOIN providers p USING(provider_id)
   WHERE pm.provider_id=? AND pm.model_identifier=?""",(pid,mid)).fetchone()
 if not row:raise SystemExit(f'Provider/model route not found: {pid}/{mid}')
 api=row['api_style'] or 'openai-completions';env=row['auth_env_var']
 try:inputs=json.loads(row['input_modalities_json']) if row['input_modalities_json'] and row['input_modalities_json'].strip().startswith('[') else ['text']
 except (TypeError,json.JSONDecodeError):inputs=['text']
 model={'id':mid,'name':row['display_name'] or mid,'reasoning':bool(row['reasoning']),'thinkingLevelMap':ASIDE_THINKING_LEVEL_MAP if row['reasoning'] else None,'input':inputs,'contextWindow':row['context_window_tokens'] or ASIDE_DEFAULT_CONTEXT,'maxTokens':row['max_output_tokens'] or ASIDE_DEFAULT_MAX_TOKENS}
 model={k:v for k,v in model.items() if v is not None}
 provider={'name':row['provider_name'] or pid,'baseUrl':row['base_url'],'api':api,'authHeader':bool(env),'compat':ASIDE_COMPAT,'models':[model]}
 if env:provider['apiKey']=f'${env}'
 cred={pid:{'type':'api_key','key':f'${env}'}} if env else None
 return pid,provider,cred,model

def aside_fragment(c,a):
 pid,provider,cred,model=aside_provider_fragment(c,a.provider,a.model)
 print(json.dumps({'provider':pid,'model':a.model,'cli_invocation':f'aside -m {pid}/{a.model}','aside_models_json':{'providers':{pid:provider}},'aside_credentials_json':cred,'notes':['Use the combined `-m <provider>/<model>` form; the separate `-p <provider> -m <model>` flags only resolve built-in providers.','Requires an Aside app restart to load a newly added custom provider (the daemon caches models.json at startup).','The API key must be a literal value in models.json or credentials.json; the Aside daemon does not expand $ENV references from the app launch environment.']},indent=2))

def _aside_backup(path):
 if not path.exists():return None
 backup=path.with_name(path.name+f'.bak.aside-{datetime.now().strftime("%Y%m%d-%H%M%S-%f")}')
 shutil.copy2(path,backup);return str(backup)


def _aside_load_json(path,default):
 if not path.exists():return default
 try:return json.loads(path.read_text())
 except (OSError,json.JSONDecodeError) as exc:raise SystemExit(f'Invalid Aside JSON at {path}: {exc}')


def _aside_write_json(path,data):
 path.write_text(json.dumps(data,indent=2)+'\n')
 json.loads(path.read_text())


def _aside_update_settings(provider,model,effort=None):
 path=ASIDE_DIR/'settings.json';d=_aside_load_json(path,{})
 current=d.get('defaultModel') if isinstance(d.get('defaultModel'),dict) else {}
 selected_effort=effort or (current.get('thinkingLevel') if current.get('provider')==provider and current.get('modelId')==model else 'high')
 if selected_effort not in ASIDE_THINKING_LEVEL_MAP:
  raise SystemExit(f'Aside effort must be one of: {", ".join(ASIDE_THINKING_LEVEL_MAP)}; ultrabrowse is a separate proactive mode')
 d['defaultModel']={'provider':provider,'modelId':model,'thinkingLevel':selected_effort,'fastMode':bool(current.get('fastMode',False))}
 return path,d


