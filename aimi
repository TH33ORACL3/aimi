def refresh_local_harnesses():
    scanner=ROOT/'scan_local_harnesses.py'
    result=subprocess.run([sys.executable,str(scanner)],capture_output=True,text=True,timeout=30)
    if result.returncode:
        detail=(result.stderr or result.stdout).strip()
        raise SystemExit(f'Live harness scan failed: {detail}')


def db(write=False):
 """Open the catalogue read-only unless a command declares that it writes.

 Every query command is a reader. Opening read-only means a CLI bug, a bad
 query, or an interrupted command cannot damage the authoritative database,
 and it cannot block the 15-minute endpoint monitor from committing.
 """
 if not DB.exists():raise SystemExit(f'No AIMI database at {DB}. Run: python install.py')
 c=sqlite3.connect(f'file:{DB}?mode={"rw" if write else "ro"}',uri=True,timeout=30)
 c.row_factory=sqlite3.Row;c.execute('PRAGMA foreign_keys=ON');c.execute('PRAGMA busy_timeout=30000');return c
