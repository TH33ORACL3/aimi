def _grok_config_block(c, provider, model, force=False):
    """Generate a Grok config.toml [model.*] block for a provider/model route. Returns a dict."""
    row = c.execute("""SELECT pm.provider_id, pm.model_identifier, pm.display_name, pm.reasoning,
        pm.context_window_tokens, pm.max_output_tokens, pm.provider_metadata_json,
        p.base_url, p.api_style, p.auth_env_var
      FROM provider_models_v2 pm JOIN providers p USING(provider_id)
      WHERE pm.provider_id=? AND pm.model_identifier=?""", (provider, model)).fetchone()
    if not row:
        raise SystemExit(f'Provider/model route not found: {provider}/{model}')
    meta = _decode_json(row['provider_metadata_json']) or {}
    reasoning = bool(row['reasoning'])
    if not reasoning and not force:
        return {'warning': f'{provider}/{model} has reasoning=NULL in the database; thinking may not be supported', 'force_with': '--force'}

    hps = c.execute("""SELECT config_schema_json, compatibility_notes FROM harness_provider_support
        WHERE harness_id='grok-build' AND provider_id=?""", (provider,)).fetchone()

    config_key = f'{provider}-{model}'.replace('/','-').replace('.','-').replace('@','')
    display_name = row['display_name'] or model
    ctx = row['context_window_tokens'] or 128000
    max_tok = row['max_output_tokens'] or 8192
    provider_env_key = row['auth_env_var'] or 'XAI_API_KEY'

    if hps and reasoning:
        schema = _decode_json(hps['config_schema_json']) or {}
        tc = schema.get('thinking', {})
        api_backend = tc.get('api_backend', 'chat_completions')
        extra_headers = tc.get('extra_headers')
        route_efforts = meta.get('reasoning_efforts') or ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']
        effort = tc.get('reasoning_efforts', route_efforts)[-1]  # default to highest effort
        all_efforts = tc.get('reasoning_efforts', route_efforts)
        notes = tc.get('notes', '')

        base_url_from_schema = tc.get('base_url')
        if base_url_from_schema:
            base = base_url_from_schema.replace('{base_url}', row['base_url'] or '')
        else:
            base = row['base_url'] or ''

        add_headers = ''
        if extra_headers:
            headers_str = ', '.join(f'"{k}" = "{v}"' for k, v in extra_headers.items())
            add_headers = f'\nextra_headers = {{ {headers_str} }}'

        config_str = '\n'.join([
            f'# Grok CLI config for {provider}/{model} with thinking enabled',
            f'# Generated by aimi grok-config on {datetime.now(timezone.utc).strftime("%Y-%m-%d")}',
            f'# {notes}',
            f'[model.{config_key}]',
            f'model = "{model}"',
            f'base_url = "{base}"',
            f'name = "{display_name} (Thinking)"',
            f'description = "{display_name} via {api_backend} backend with thinking"',
            f'api_backend = "{api_backend}"',
            f'env_key = "{provider_env_key}"',
            f'context_window = {ctx}',
            f'max_completion_tokens = {max_tok}',
            f'temperature = 0.7',
            f'reasoning_effort = "{effort}"',
            f'supports_reasoning_effort = true',
            f'reasoning_efforts = [{", ".join(f'"{e}"' for e in all_efforts)}]',
        ]) + add_headers

        return {
            'provider': provider, 'model': model, 'config_key': config_key,
            'thinking_enabled': reasoning, 'config_toml': config_str,
            'api_backend': api_backend, 'harness_support_notes': hps['compatibility_notes'],
        }
    else:
        extra_lines = []
        if reasoning:
            efforts = meta.get('reasoning_efforts', ['low', 'medium', 'high'])
            highest = efforts[-1] if efforts else 'high'
            extra_lines.append(f'# This model supports reasoning (efforts: {", ".join(efforts)})')
            extra_lines.append(f'reasoning_effort = "{highest}"')
            extra_lines.append('supports_reasoning_effort = true')
            extra_lines.append(f'reasoning_efforts = [{", ".join(f'"{e}"' for e in efforts)}]')

        toml_lines = [
            f'# Grok CLI config for {provider}/{model}',
            f'[model.{config_key}]',
            f'model = "{model}"',
            f'base_url = "{row["base_url"]}"',
            f'name = "{display_name}{" (Thinking)" if reasoning else ""}"',
            f'env_key = "{provider_env_key}"',
            f'context_window = {ctx}',
            f'max_completion_tokens = {max_tok}',
            f'temperature = 0.7',
        ]
        if extra_lines:
            for line in extra_lines:
                if line.startswith('#'):
                    toml_lines.insert(1, line)
                else:
                    toml_lines.append(line)

        return {
            'provider': provider, 'model': model, 'config_key': config_key,
            'thinking_enabled': reasoning, 'config_toml': '\n'.join(toml_lines),
            'notes': 'No harness_provider_support found for grok-build + this provider. Config may need manual adjustment.',
        }


def grok_config(c, a):
    """Generate a Grok config.toml [model.*] block with thinking enabled for a provider/model route."""
    print(json.dumps(_grok_config_block(c, a.provider, a.model, a.force), indent=2, default=str))


def _route_row(c, pid, mid):
    row = c.execute("""SELECT pm.display_name, pm.reasoning, pm.context_window_tokens, pm.max_output_tokens,
        p.display_name provider_name, p.base_url, p.api_style, p.auth_env_var
      FROM provider_models_v2 pm JOIN providers p USING(provider_id)
      WHERE pm.provider_id=? AND pm.model_identifier=?""", (pid, mid)).fetchone()
    if not row:
        raise SystemExit(f'Provider/model route not found: {pid}/{mid}')
    return row


