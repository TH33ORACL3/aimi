  if settings_backup:backups.append(settings_backup)
 return {'provider':pid,'model':mid,'path':str(ASIDE_MODELS_PATH),'credentials_path':str(ASIDE_CREDENTIALS_PATH),'backups':backups,'api_key_embedded':bool(key),'api_key_source':f'env {env}' if key else (f'env placeholder ${env}' if env else 'no key required'),'cli_invocation':f'aside -m {pid}/{mid}','default_before':default_before,'default_after':default_after,'default_updated':set_default,'settings_path':str(settings_path) if settings_path else None,'model':model}


