                      'Roles: default, smol, slow, plan, advisor. Config applies to new sessions; the daemon rewrites config.yml on live model switches.']}


def omp_select(c, a):
    """Set one omp model role via read-modify-write of the modelRoles record.

    omp rejects dotted keys (modelRoles.smol), so the command reads the live
    record, updates one role, writes the whole record back as JSON, and verifies.
    Previews unless --apply. Backs up config.yml before writing.
    """
    _route_row(c, a.provider, a.model)  # raises if the AIMI route is unknown
    cfg = Path.home()/'.omp/agent/config.yml'
    if not cfg.exists():
        raise SystemExit(f'No omp config at {cfg}')
    def roles_now():
        r = subprocess.run(['omp','config','get','modelRoles'], capture_output=True, text=True, timeout=15)
        if r.returncode:
            raise SystemExit(f'omp config get modelRoles failed: {r.stderr.strip() or r.stdout.strip()}')
        try: return json.loads(r.stdout or '{}')
        except Exception: return {}
    roles = roles_now()
    new_mid = f'{a.provider}/{a.model}'
    old_mid = roles.get(a.role)
    preview = {'harness':'omp','role':a.role,'current':old_mid,'proposed':new_mid,
               'config_path':str(cfg),
               'note':'omp must be able to resolve the model id (model cache or extension provider); run `omp models ls` to check.'}
    if not a.apply:
        print(json.dumps(preview, indent=2, default=str)); return
    roles[a.role] = new_mid
    backup = ROOT/'backups'/f'omp-config.bak-{datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")}.yml'
    backup.parent.mkdir(exist_ok=True)
    shutil.copy2(cfg, backup)
    r = subprocess.run(['omp','config','set','modelRoles', json.dumps(roles)], capture_output=True, text=True, timeout=15)
    if r.returncode:
        raise SystemExit(f'omp config set modelRoles failed: {r.stderr.strip() or r.stdout.strip()}')
    preview.update({'backup':str(backup),'verified':roles_now().get(a.role)==new_mid})
    print(json.dumps(preview, indent=2, default=str))


