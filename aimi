 if chargeable and not a.allow_paid:
  print(json.dumps({'provider':a.provider,'model':a.model,'access_type':offer or 'unclassified','skipped':True,
   'reason':'Route is not verified as no-charge. One tiny request may consume paid or subscription quota.',
   'override':'--allow-paid'},indent=2));return
