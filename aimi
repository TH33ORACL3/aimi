     AND (ao.ends_at IS NULL OR datetime(ao.ends_at)>datetime('now'))
     ORDER BY CASE ao.offer_type WHEN 'genuine_zero_price' THEN 1 WHEN 'temporary_free_window' THEN 2 WHEN 'free_tier_quota' THEN 3 WHEN 'subscription_included' THEN 4 WHEN 'paid' THEN 5 ELSE 6 END LIMIT 1) offer_type
   FROM provider_models_v2 pm JOIN providers p USING(provider_id)
   WHERE pm.provider_id=? AND pm.model_identifier=?""",(a.provider,a.model)).fetchone()
