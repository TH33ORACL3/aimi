def deepseek_status(c, a):
    """Report whether the current local time is DeepSeek API peak or off-peak."""
    try:
        result = deepseek_schedule.status_at(a.at, a.timezone)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    print(json.dumps(result, indent=2))

