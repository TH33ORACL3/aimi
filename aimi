def changes_review(c,a):
 """Mark endpoint changes reviewed. Previews by default; --apply writes.

 Endpoint changes are the durable event log, and validation requires them to
 be triaged. Without this command the backlog can only grow, so validation
 can never pass. Filters are the same ones `aimi changes` accepts, so an
 agent can review exactly the set it just read.
 """
 clauses=['reviewed=0'];params=[]
 if a.provider:clauses.append('provider_id=?');params.append(a.provider)
 if a.type:clauses.append('change_type=?');params.append(a.type)
 if a.since:clauses.append('date(detected_at)>=date(?)');params.append(a.since)
 if a.until:clauses.append('date(detected_at)<=date(?)');params.append(a.until)
 if a.model:clauses.append('model_identifier LIKE ?');params.append(f'%{a.model}%')
 if a.max_id is not None:clauses.append('endpoint_change_id<=?');params.append(a.max_id)
 if a.id:
  marks=','.join('?'*len(a.id));clauses.append(f'endpoint_change_id IN ({marks})');params.extend(a.id)
 where=' AND '.join(clauses)
 matched=c.execute(f'SELECT COUNT(*) FROM endpoint_changes WHERE {where}',params).fetchone()[0]
 breakdown=[dict(x) for x in c.execute(f'SELECT provider_id,change_type,COUNT(*) matches,MIN(detected_at) earliest,MAX(detected_at) latest FROM endpoint_changes WHERE {where} GROUP BY 1,2 ORDER BY matches DESC',params)]
 sample=[dict(x) for x in c.execute(f'SELECT endpoint_change_id,provider_id,change_type,model_identifier,detected_at FROM endpoint_changes WHERE {where} ORDER BY endpoint_change_id DESC LIMIT 10',params)]
 out={'filters':{'provider':a.provider,'type':a.type,'since':a.since,'until':a.until,'model':a.model,'max_id':a.max_id,'ids':a.id},'matched_unreviewed':matched,'breakdown':breakdown,'sample':sample,'note':a.note,'apply':bool(a.apply)}
 if a.apply:
  if not a.note:raise SystemExit('Refusing to mark changes reviewed without --note explaining the decision')
  cur=c.execute(f'UPDATE endpoint_changes SET reviewed=1,review_notes=? WHERE {where}',[a.note]+params)
  c.commit();out['marked_reviewed']=cur.rowcount
  out['remaining_unreviewed']=c.execute('SELECT COUNT(*) FROM endpoint_changes WHERE reviewed=0').fetchone()[0]
 else:
  out['hint']='Re-run with --note "<why>" --apply to record the review'
 print(json.dumps(out,indent=2,default=str))


