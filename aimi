            'config': {'models_json': {'providers': {p: provider}}, 'credentials_json': cred}}


def _gen_grok(c, pid, mid):
    return {'path': '~/.grok/config.toml',
            'apply': f'aimi grok-config {pid} {mid}',
            'config': _grok_config_block(c, pid, mid, force=True)}


