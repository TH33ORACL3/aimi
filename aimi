def _gen_zcode(c, pid, mid):
    row = _route_row(c, pid, mid)
    # ZCode stores custom OpenAI-compatible providers under provider.<key> with
    # source=='custom', options.baseURL and a models map. The apiKey is embedded
    # literally (ZCode expands no env var in the field), so the apply step must
    # substitute the current value of the auth env var.
    return {'path': '~/.zcode/v2/config.json',
            'apply': 'add a provider.<key> block (source=custom, kind=openai-compatible); ZCode stores the apiKey literally, so substitute the current value of the auth env var',
            'config': {'name': row['provider_name'], 'kind': 'openai-compatible',
                       'source': 'custom', 'enabled': True,
                       'options': {'baseURL': row['base_url'], 'apiKey': f'${row["auth_env_var"]}'},
                       'models': {mid: {'limit': {'context': row['context_window_tokens'] or 128000,
                                                  'output': row['max_output_tokens'] or 16384},
                                        'modalities': {'input': ['text'], 'output': ['text']},
                                        'zcode': {'modified': False, 'priority': 100}}}},
            'env_key': row['auth_env_var']}


