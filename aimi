def timeline(c,a):
    """Fast release/availability timeline query for an arbitrary date range."""
    params=[a.since]
    end_clause=''
    if a.until:
        end_clause=' AND date(e.event_time) <= date(?)'
        params.append(a.until)
    q=f"""SELECT COALESCE(cm.canonical_name, pm.display_name, pm.model_identifier) model,
        COALESCE(cm.developer, '') developer, e.event_type, e.event_time, e.time_precision,
        COALESCE(p.provider_id, '') provider_id, COALESCE(pm.model_identifier, '') model_identifier,
        es.url evidence_url, e.confidence
        FROM model_events e
        LEFT JOIN canonical_models cm ON cm.canonical_model_id=e.canonical_model_id
        LEFT JOIN provider_models_v2 pm ON pm.provider_model_id=e.provider_model_id
        LEFT JOIN providers p ON p.provider_id=pm.provider_id
        JOIN evidence_sources es ON es.evidence_source_id=e.evidence_source_id
        WHERE date(e.event_time) >= date(?) {end_clause}
          AND e.event_type IN ('announcement','preview_release','general_release','api_availability','model_card_publication','weights_release','endpoint_first_seen')
        ORDER BY date(e.event_time) DESC, e.event_type, model"""
    rows_json(c.execute(q,params).fetchall())
