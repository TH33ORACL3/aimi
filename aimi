def changes(c,a):
    clauses=[];params=[]
    if a.provider:clauses.append('ec.provider_id=?');params.append(a.provider)
    if not a.all:clauses.append('ec.reviewed=0')
    if a.since:clauses.append('date(ec.detected_at)>=date(?)');params.append(a.since)
    if a.until:clauses.append('date(ec.detected_at)<=date(?)');params.append(a.until)
    if a.type:clauses.append('ec.change_type=?');params.append(a.type)
    if a.model:clauses.append('(ec.model_identifier LIKE ? OR COALESCE(pm.display_name,\'\') LIKE ?)');params.extend([f'%{a.model}%',f'%{a.model}%'])
    diff=',ec.before_json,ec.after_json' if a.diff else ''
    where=' AND '.join(clauses) or '1=1'
    q=f"""SELECT ec.endpoint_change_id,ec.monitoring_run_id,ec.provider_id,ec.change_type,ec.model_identifier,
        COALESCE(pm.display_name,ec.model_identifier) display_name,ec.detected_at,ec.reviewed,ec.review_notes,
        mr.started_at run_started_at,mr.status run_status,mr.http_status run_http_status,mt.url endpoint_url{diff}
        FROM endpoint_changes ec
        JOIN monitoring_runs mr USING(monitoring_run_id)
        JOIN monitoring_targets mt USING(monitoring_target_id)
        LEFT JOIN provider_models_v2 pm ON pm.provider_id=ec.provider_id AND pm.model_identifier=ec.model_identifier
        WHERE {where} ORDER BY datetime(ec.detected_at) DESC,ec.endpoint_change_id DESC LIMIT ?"""
    params.append(a.limit);rows_json(c.execute(q,params).fetchall())
