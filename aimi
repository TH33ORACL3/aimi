def _provider_models_payload(c, provider_id, include_removed=False):
 provider=c.execute('SELECT provider_id,display_name,official_models_endpoint,base_url FROM providers WHERE provider_id=?',(provider_id,)).fetchone()
 if not provider:raise SystemExit(f'Provider not found: {provider_id}')
 status_clause='' if include_removed else " AND pm.endpoint_status NOT IN ('removed','unavailable')"
 q=f"""SELECT pm.provider_model_id,pm.provider_id,p.display_name provider_name,
 pm.model_identifier,pm.display_name,pm.description,pm.provider_created_at,
 pm.endpoint_status,pm.endpoint_first_seen_at,pm.endpoint_last_seen_at,pm.endpoint_removed_at,
 pm.context_window_tokens,pm.max_input_tokens,pm.max_output_tokens,pm.reasoning,pm.tools,
 pm.function_calling,pm.structured_outputs,pm.streaming,pm.input_modalities_json,pm.output_modalities_json,
 (SELECT mt.url FROM monitoring_targets mt WHERE mt.provider_id=pm.provider_id AND mt.target_type='models_endpoint' ORDER BY mt.monitoring_target_id DESC LIMIT 1) endpoint_url,
 (SELECT mt.last_checked_at FROM monitoring_targets mt WHERE mt.provider_id=pm.provider_id AND mt.target_type='models_endpoint' ORDER BY mt.monitoring_target_id DESC LIMIT 1) endpoint_last_checked_at,
 (SELECT mt.last_success_at FROM monitoring_targets mt WHERE mt.provider_id=pm.provider_id AND mt.target_type='models_endpoint' ORDER BY mt.monitoring_target_id DESC LIMIT 1) endpoint_last_success_at,
 (SELECT mt.last_changed_at FROM monitoring_targets mt WHERE mt.provider_id=pm.provider_id AND mt.target_type='models_endpoint' ORDER BY mt.monitoring_target_id DESC LIMIT 1) endpoint_last_changed_at
 FROM provider_models_v2 pm JOIN providers p USING(provider_id)
 WHERE pm.provider_id=?{status_clause}
 ORDER BY COALESCE(pm.display_name,pm.model_identifier),pm.model_identifier"""
 models=[]
 for row in c.execute(q,(provider_id,)).fetchall():
  model=dict(row);pmid=model['provider_model_id']
  for key in ('input_modalities_json','output_modalities_json'):
   out_key=key[:-5]
   model[out_key]=_decode_json(model.pop(key)) if model.get(key) else None
  model['subscription_access']=[dict(x) for x in c.execute("""SELECT sp.product_slug,sma.access_type,sma.confidence,sma.last_verified_at,sma.notes
   FROM subscription_model_access sma JOIN subscription_products sp USING(subscription_product_id)
   WHERE sma.provider_model_id=? ORDER BY sp.product_slug,sma.access_type""",(pmid,)).fetchall()]
  model['detected_in_endpoint_changes']=c.execute("SELECT COUNT(*) FROM endpoint_changes WHERE provider_id=? AND model_identifier=? AND change_type='model_added'",(provider_id,model['model_identifier'])).fetchone()[0]>0
  models.append(model)
 return {'provider_id':provider['provider_id'],'provider_name':provider['display_name'],'official_models_endpoint':provider['official_models_endpoint'],'base_url':provider['base_url'],'include_removed':bool(include_removed),'model_count':len(models),'models':models}

